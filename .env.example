# Public Supabase values. Safe to expose to the browser.
# Leave both blank to use the labeled local demo session (no real auth).
# The Supabase service role key is not used by this app and must not be
# placed here or in any NEXT_PUBLIC_ variable. The browser never sees it.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_. Leave blank and the coach
# answers from the lesson notes. Do not commit a real key.
OPENAI_API_KEY=
