# Public Supabase values. Safe to expose to the browser.
# Leave both blank to use the labeled local demo session (no real auth).
# The Supabase service role key is not used by this app and must not be
# placed here or in any NEXT_PUBLIC_ variable. The browser never sees it.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. 32+ random characters, for example: openssl rand -hex 32
# Signs the lead-gate and demo cookies so they cannot be forged. Set it in Vercel.
APP_SECRET=

# The local demo login is OFF in production. Set to 1 only for a throwaway preview.
ALLOW_DEMO_MODE=

# Server only. Never prefix this with NEXT_PUBLIC_. Leave blank and the coach
# answers from the lesson notes. Do not commit a real key.
OPENAI_API_KEY=

# Optional. Set when you attach a custom domain, so sitemap and metadata use it.
NEXT_PUBLIC_SITE_URL=

# Social sign-in buttons. List only the providers you have switched on in
# Supabase (Authentication, Providers). Leave blank to show email sign-in only.
# Example: google,github
NEXT_PUBLIC_AUTH_PROVIDERS=

# Preview mode only: emails (comma separated) allowed into /admin/jobs without a database.
# With Supabase, admins come from the admins table instead (see README).
ADMIN_EMAILS=
# Where every job points applicants. Defaults to hemanofficial6@gmail.com.
NEXT_PUBLIC_JOBS_CONTACT_EMAIL=
